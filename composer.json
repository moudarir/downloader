{
  "name": "moudarir/downloader",
  "description": "Modern PHP download library with RFC 9110 support.",
  "type": "library",
  "homepage": "https://github.com/moudarir/downloader",
  "license": "MIT",
  "keywords": [
    "download",
    "http",
    "etag",
    "range",
    "stream",
    "php",
    "rfc9110"
  ],
  "authors": [
    {
      "name": "Abdessamad MOUDARIR",
      "email": "amoudarir@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "moudarir/mime-detector": "^1.0"
  },
  "autoload": {
    "psr-4" : {
      "Moudarir\\Downloader\\" : "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Moudarir\\Downloader\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "scripts": {
    "server-start": "bash examples/start-server.sh",
    "server-stop": "bash examples/stop-server.sh",
    "test:integration": "bash examples/test-integration.sh",
    "test:unit": "phpunit tests/Unit",
    "test": [
      "@test:unit",
      "@test:integration"
    ]
  }
}
